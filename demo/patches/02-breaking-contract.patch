Subject: pricing: rename unit_rate to unit_rate_pence to make the unit explicit

diff --git a/services/pricing/openapi.yaml b/services/pricing/openapi.yaml
index 0f12bc6..9625493 100644
--- a/services/pricing/openapi.yaml
+++ b/services/pricing/openapi.yaml
@@ -44,10 +44,10 @@ components:
     Price:
       type: object
       additionalProperties: false
-      required: [tariff_code, unit_rate, standing_charge, annual_cost, currency]
+      required: [tariff_code, unit_rate_pence, standing_charge, annual_cost, currency]
       properties:
         tariff_code: { type: string }
-        unit_rate: { type: number, description: "pence per kWh" }
+        unit_rate_pence: { type: number, description: "pence per kWh" }
